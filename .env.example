# UniFi Access controller. Create the token in UniFi Access:
#   Settings -> General -> Advanced -> API Token (give it door view + door operate permissions)
# The API port is usually 12445 with a self-signed certificate.
UNIFI_ACCESS_HOST=https://192.168.1.1:12445
UNIFI_ACCESS_TOKEN=changeme
UNIFI_VERIFY_TLS=false

# Leave the token as "changeme" (or set DRY_RUN=true) to try OpnDoor with demo doors;
# nothing is sent to the controller in dry-run mode.
# DRY_RUN=true

# SQLite location inside the container
DATABASE_URL=sqlite:////data/scheduler.db

# Optional. Random key is generated and kept in /data/secret_key if unset.
# SECRET_KEY=
# Set true when OpnDoor is served over HTTPS behind a reverse proxy.
# SECURE_COOKIES=true

# Tuning (defaults shown)
# RECONCILE_SECONDS=30
# DOOR_SYNC_MINUTES=10
# CALENDAR_SYNC_MINUTES=5
# CALENDAR_LOOKAHEAD_DAYS=60
