# First UniFi Access console. On first start it becomes a site called UNIFI_SITE_NAME.
# More consoles (sites) are added in the web UI under Sites; these values are only read once.
# Create the token in UniFi Access:
#   Settings -> General -> Advanced -> API Token (give it door view + door operate permissions)
# The API port is usually 12445 with a self-signed certificate.
UNIFI_ACCESS_HOST=https://192.168.1.1:12445
UNIFI_ACCESS_TOKEN=changeme
UNIFI_VERIFY_TLS=false
UNIFI_SITE_NAME=Main site

# Leave the token as "changeme" to start with a demo site of pretend doors.
# DRY_RUN=true makes every site a demo console (nothing is sent anywhere).
# DRY_RUN=false

# SQLite location inside the container
DATABASE_URL=sqlite:////data/scheduler.db

# Sign in with Microsoft (optional). See README "Sign in with Microsoft".
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# The address people use to reach OpnDoor (needed for Microsoft sign-in)
# PUBLIC_URL=https://doors.example.org

# Optional. Random key is generated and kept in /data/secret_key if unset.
# SECRET_KEY=
# Set true when OpnDoor is served over HTTPS behind a reverse proxy.
# SECURE_COOKIES=true

# Tuning (defaults shown)
# RECONCILE_SECONDS=30
# DOOR_SYNC_MINUTES=10
# CALENDAR_SYNC_MINUTES=5
# CALENDAR_LOOKAHEAD_DAYS=60
